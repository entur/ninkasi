{
  "name": "ninkasi",
  "version": "0.5.7",
  "description": "Admin GUI for internal usage",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "check": "biome check .",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "license": "EUPL",
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/x-date-pickers": "9.13.0",
    "@reduxjs/toolkit": "2.12.0",
    "axios": "1.20.0",
    "chai": "6.2.2",
    "chart.js": "4.5.1",
    "date-fns": "4.4.0",
    "duration-fns": "3.0.2",
    "file-saver": "2.0.5",
    "lodash": "4.18.1",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.0",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.3.0",
    "react-dropzone": "20.1.2",
    "react-oidc-context": "3.3.1",
    "react-redux": "9.3.0",
    "react-router-dom": "7.18.4",
    "redux": "5.0.1",
    "uuid": "14.0.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,html}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "husky": "9.1.7",
    "jsdom": "30.1.0",
    "lint-staged": "17.5.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
